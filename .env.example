# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=qa_platform
POSTGRES_PORT=5432

# Application Configuration
# For local execution outside Docker:
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/qa_platform
# Inside Docker Compose, the API service connects to the 'postgres' service:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@postgres:5432/qa_platform

# Security & JWT
SECRET_KEY=GENERATE_YOUR_OWN_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI-compatible AI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional override for OpenAI-compatible providers
# OPENAI_BASE_URL=https://api.openai.com/v1
